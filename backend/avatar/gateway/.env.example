# Shared secret your Next.js server sends as the X-Gateway-Secret header.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_SECRET=change-me-to-a-long-random-string

# Must match WORKER_TOKEN in the worker's .env
WORKER_TOKEN=change-me-to-a-long-random-string

# Workers in priority order, comma-separated. First healthy one wins.
#   Dev (everything on your PC):  http://127.0.0.1:8100
#   On the Pi:                    http://<pc-lan-ip>:8100,http://127.0.0.1:8100
WORKER_URLS=http://127.0.0.1:8100

# PERSONA_FILE=persona.md
# MAX_HISTORY=24
# MAX_MESSAGE_CHARS=8000
