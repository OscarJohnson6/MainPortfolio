# Shared secret the gateway sends as "Authorization: Bearer <token>".
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_TOKEN=change-me-to-a-long-random-string

# Shows up in the UI so you can tell which machine answered.
WORKER_NAME=pc

# Ollama stays on localhost; only this worker is exposed.
OLLAMA_URL=http://127.0.0.1:11434

# Optional: force a profile from models.yaml instead of auto-detecting VRAM.
# On the Pi fallback worker, set this to "cpu".
# WORKER_PROFILE=vram_8gb
